---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<nav class="sticky top-24">
  <h4 class="text-sm font-semibold text-slate-900 mb-3">On this page</h4>
  <ul class="space-y-2 border-l border-slate-200">
    {headings.map((h) => (
      <li class="pl-4" style={`padding-left: ${(h.depth - 1) * 12}px`}>
        <a
          href={`#${h.slug}`}
          class="text-sm text-slate-500 hover:text-blue-600 transition-colors block py-0.5"
        >
          {h.text}
        </a>
      </li>
    ))}
  </ul>
</nav>
