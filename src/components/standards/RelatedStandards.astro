---
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"standards">[];
}

const { entries } = Astro.props;

if (entries.length === 0) return null;
---

<div class="mt-12 pt-8 border-t border-slate-200">
  <h3 class="text-lg font-semibold text-slate-900 mb-4">Related Standards</h3>
  <div class="grid gap-3 sm:grid-cols-2">
    {entries.map((entry) => (
      <a
        href={`/standards/${entry.id}`}
        class="block rounded-lg border border-slate-200 p-4 hover:border-blue-300 hover:bg-slate-50 transition-colors"
      >
        <h4 class="font-medium text-slate-900 mb-1">{entry.data.title}</h4>
        <p class="text-sm text-slate-500 line-clamp-2">{entry.data.description}</p>
      </a>
    ))}
  </div>
</div>
