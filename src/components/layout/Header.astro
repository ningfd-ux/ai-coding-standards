---
import MobileDrawer from "./MobileDrawer";

const navLinks = [
  { href: "/standards", label: "Standards" },
  { href: "/frameworks", label: "Frameworks" },
  { href: "/about", label: "About" },
];
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/60">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 font-semibold text-slate-900">
        <span class="flex items-center justify-center w-8 h-8 rounded bg-primary-600 text-white text-sm font-bold">&lt;/&gt;</span>
        <span class="hidden sm:inline">AI Coding Standards</span>
        <span class="sm:hidden">AICS</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-6">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Mobile Drawer -->
      <div class="md:hidden">
        <MobileDrawer client:load />
      </div>
    </div>
  </div>
</header>
