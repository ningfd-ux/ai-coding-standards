---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { sortByDate } from "../../utils/content";

const allStandards = await getCollection("standards");
const sortedStandards = sortByDate(allStandards);
---

<BaseLayout
  title="All Standards"
  description="Browse all AI coding standards organized by topic. Production-ready patterns and best practices for AI-assisted development."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-10">
      <h1 class="text-3xl font-bold text-slate-900 mb-3">All Standards</h1>
      <p class="text-lg text-slate-500">
        Production-ready coding standards and AI-friendly engineering guidelines.
      </p>
    </div>

    {sortedStandards.length === 0 ? (
      <div class="rounded-lg border border-slate-200 bg-slate-50 p-12 text-center">
        <p class="text-slate-500">No standards published yet. Check back soon.</p>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sortedStandards.map((entry) => (
          <a
            href={`/standards/${entry.id}`}
            class="group rounded-xl border border-slate-200 bg-white p-6 hover:border-blue-300 hover:shadow-sm transition-all"
          >
            <div class="flex flex-wrap gap-1.5 mb-3">
              {entry.data.tags.slice(0, 3).map((tag) => (
                <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">
                  {tag}
                </span>
              ))}
            </div>
            <h3 class="font-semibold text-slate-900 group-hover:text-blue-600 transition-colors mb-2">
              {entry.data.title}
            </h3>
            <p class="text-sm text-slate-500 line-clamp-2 mb-4">
              {entry.data.description}
            </p>
            <time class="text-xs text-slate-400" datetime={entry.data.publishedAt.toISOString()}>
              {entry.data.publishedAt.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
